{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist/types",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2020",
    "skipLibCheck": true,
    "strict": false,
    "noImplicitAny": false
  },
  "include": ["index.js", "src/**/*.js"],
  "exclude": ["node_modules", "examples", "test"]
}
